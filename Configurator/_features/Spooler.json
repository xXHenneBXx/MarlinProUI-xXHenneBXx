{
  "Configuration.h": [
    {
      "op": "Enable",
      "searchfor": "FILAMENT_RUNOUT_SENSOR",
      "comment": "Spooler runout detection - enable if you have a sensor"
    },
    {
      "op": "CustomVal",
      "searchfor": "FIL_RUNOUT_ENABLED_DEFAULT",
      "value": "false",
      "comment": "Disabled by default - many users have no sensor"
    },
    {
      "op": "CustomVal",
      "searchfor": "FILAMENT_RUNOUT_DISTANCE_MM",
      "value": "15",
      "comment": "Spooler runout distance"
    },
    {
      "op": "Custom",
      "searchfor": "FILAMENT_RUNOUT_SCRIPT",
      "mask": "\".*\"",
      "value": "\"M0\"",
      "comment": "Stop machine on runout - no M600 since ADVANCED_PAUSE is disabled"
    }
  ],
  "Configuration_adv.h": [],
  "Version.h": []
}
