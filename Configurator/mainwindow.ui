   <property name="styleSheet">
    <string notr="true">QWidget
{
	background-image: url(:/icons/icons/App/background.png);
}

QGroupBox
 {
	background: qlineargradient(spread:pad, x1:0, y1:1, x2:0, y2:0.25,
							stop:0 rgba(29, 192, 197, 0.92),
							stop:0.32 rgba(34, 126, 255, 0.55),
							stop:1 rgba(22, 27, 34, 0.98));
	border: 1.55px solid rgba(96, 162, 255, 0.5);
	border-radius: 10px;
	margin-top: 12px;
	font-weight: 600;
	color: #dff7ff;
	padding-top: 8px;
}

QWidget#headerWidget {
            background: qlineargradient(spread:pad, x1:0, y1:1, x2:0, y2:0,
                                        stop:0 rgba(29, 192, 197, 0.92),
                                        stop:0.35 rgba(35, 134, 255, 0.54),
                                        stop:1 rgba(13, 17, 23, 0.96));
            border: 1px solid rgba(96, 162, 255, 0.4);
            border-radius: 10px;
}

QGroupBox QCheckBox, QGroupBox QRadioButton {
        spacing: 8px;
        background: none;
        border: none;
}

QCheckBox::indicator, QRadioButton::indicator {
        width: 14px;
        height: 14px;
        border: 1px solid #30363d;
        background: #1c2128;
}

QCheckBox::indicator:checked, QRadioButton::indicator:checked {
        background: #48ff00;
        border-color: #58a6ff;
}

    QScrollBar:vertical {
        border: none;
        background: rgba(22, 27, 34, 0.5); 
        width: 6px;
        margin: 0px;
        border-radius: 3px;
    }

    QScrollBar::handle:vertical {
        background: rgba(34, 126, 255, 0.55);
        min-height: 15px;
        border-radius: 3px;
    }

    QScrollBar::handle:vertical:hover {
        background: rgba(34, 126, 255, 0.85);
    }

    QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
        height: 0px;
        background: none;
    }</string>
   </property>
